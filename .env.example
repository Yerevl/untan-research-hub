# =========================================================
# Konfigurasi Supabase untuk Untan Research Hub
# Dapatkan nilai ini dari Dashboard Supabase Anda:
# Project Settings -> API
# =========================================================

# URL Project Supabase (Contoh: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (Aman digunakan di browser client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (Hanya digunakan di server-side untuk scraper dan storage upload)
# PERINGATAN: Jangan pernah mengekspos key ini ke publik!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

